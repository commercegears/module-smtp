<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="commercegears_smtp_queue" instance="CommerceGears\Smtp\Cron\ProcessQueue" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="commercegears_smtp_log_cleanup" instance="CommerceGears\Smtp\Cron\Cleanup" method="execute">
            <schedule>17 3 * * *</schedule>
        </job>
    </group>
</config>
