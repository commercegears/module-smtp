<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Before Magento's "Disable Email Communications" plugin (sortOrder 0), so held-back emails are logged. -->
    <type name="Magento\Framework\Mail\TransportInterface">
        <plugin name="commercegears_smtp_transport" type="CommerceGears\Smtp\Plugin\TransportPlugin" sortOrder="-100"/>
    </type>
    <type name="Magento\Framework\Mail\Template\TransportBuilder">
        <plugin name="commercegears_smtp_template_context" type="CommerceGears\Smtp\Plugin\TransportBuilderPlugin"/>
    </type>
    <type name="CommerceGears\Smtp\Model\TemplateContext" shared="true"/>
    <type name="CommerceGears\Smtp\Model\Smtp\Sender" shared="true"/>

    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="commercegears_smtp/connection/password" xsi:type="string">1</item>
                <item name="commercegears_smtp/connection/oauth_client_secret" xsi:type="string">1</item>
                <item name="commercegears_smtp/connection/username" xsi:type="string">1</item>
            </argument>
            <argument name="environment" xsi:type="array">
                <item name="commercegears_smtp/general/enabled" xsi:type="string">1</item>
                <item name="commercegears_smtp/connection/host" xsi:type="string">1</item>
                <item name="commercegears_smtp/connection/port" xsi:type="string">1</item>
                <item name="commercegears_smtp/delivery/mode" xsi:type="string">1</item>
                <item name="commercegears_smtp/delivery/test_recipients" xsi:type="string">1</item>
                <item name="commercegears_smtp/delivery/live_host" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="commercegears_smtp_log_listing_data_source" xsi:type="string">CommerceGears\Smtp\Model\ResourceModel\Log\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="CommerceGears\Smtp\Model\ResourceModel\Log\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">commercegears_smtp_log</argument>
            <argument name="resourceModel" xsi:type="string">CommerceGears\Smtp\Model\ResourceModel\Log</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="commercegears_smtp_test" xsi:type="object">CommerceGears\Smtp\Console\Command\TestCommand</item>
                <item name="commercegears_smtp_queue" xsi:type="object">CommerceGears\Smtp\Console\Command\QueueCommand</item>
                <item name="commercegears_smtp_clean" xsi:type="object">CommerceGears\Smtp\Console\Command\CleanCommand</item>
                <item name="commercegears_smtp_dns" xsi:type="object">CommerceGears\Smtp\Console\Command\DnsCommand</item>
            </argument>
        </arguments>
    </type>

    <type name="CommerceGears\Smtp\Console\Command\TestCommand">
        <arguments>
            <argument name="tester" xsi:type="object">CommerceGears\Smtp\Model\Diagnostics\Tester\Proxy</argument>
        </arguments>
    </type>
    <type name="CommerceGears\Smtp\Console\Command\QueueCommand">
        <arguments>
            <argument name="mailer" xsi:type="object">CommerceGears\Smtp\Model\Mailer\Proxy</argument>
        </arguments>
    </type>
    <type name="CommerceGears\Smtp\Console\Command\CleanCommand">
        <arguments>
            <argument name="cleaner" xsi:type="object">CommerceGears\Smtp\Model\Cleaner\Proxy</argument>
        </arguments>
    </type>
    <type name="CommerceGears\Smtp\Console\Command\DnsCommand">
        <arguments>
            <argument name="checker" xsi:type="object">CommerceGears\Smtp\Model\Diagnostics\DnsChecker\Proxy</argument>
            <argument name="config" xsi:type="object">CommerceGears\Smtp\Model\Config\Proxy</argument>
        </arguments>
    </type>
    <!-- The transport plugin runs on every email: load the heavy parts only when the module is on. -->
    <type name="CommerceGears\Smtp\Plugin\TransportPlugin">
        <arguments>
            <argument name="mailer" xsi:type="object">CommerceGears\Smtp\Model\Mailer\Proxy</argument>
        </arguments>
    </type>

    <virtualType name="CommerceGears\Smtp\Model\Source\Region\Ses" type="CommerceGears\Smtp\Model\Source\Region">
        <arguments>
            <argument name="provider" xsi:type="string">ses</argument>
        </arguments>
    </virtualType>
    <virtualType name="CommerceGears\Smtp\Model\Source\Region\Mailgun" type="CommerceGears\Smtp\Model\Source\Region">
        <arguments>
            <argument name="provider" xsi:type="string">mailgun</argument>
        </arguments>
    </virtualType>
    <virtualType name="CommerceGears\Smtp\Model\Source\Region\Zoho" type="CommerceGears\Smtp\Model\Source\Region">
        <arguments>
            <argument name="provider" xsi:type="string">zoho</argument>
        </arguments>
    </virtualType>
</config>
